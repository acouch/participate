# This is the prisma db URL
DATABASE_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Resend (password reset email). Without a key, dev logs the link to console.
RESEND_API_KEY=
EMAIL_FROM=

# Admin role is set by the comma listed emails below
ADMIN_EMAILS="test@test.com"
