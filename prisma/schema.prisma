generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// User, Session, Account and Verification are Better Auth's required models.
// Field names are fixed by the library — see src/lib/auth.ts.
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified Boolean  @default(false)
  name          String
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]
  budgets  Budget[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  // Hashed by Better Auth (scrypt); null for OAuth-only accounts.
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model Budget {
  id        String @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  data      Json

  // Null for budgets created anonymously via /start.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Admin-curated: set when a budget is highlighted on /featured-budgets.
  // A real column, not a field in `data`, so the budget's own editor cannot
  // overwrite it when saving.
  featuredAt DateTime?

  @@map("budget")
  @@index([userId])
  @@index([featuredAt])
  outcomes Outcome[]
}

model Outcome {
  id          String @id @default(cuid())
  createdAt   DateTime @default(now()) 
  updatedAt   DateTime @updatedAt
  budgetId    String
  budget      Budget @relation(fields: [budgetId], references: [id])
  department  String
  description String
}

model Feedback {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  name      String?
  email     String?
  message   String
  path      String?

  @@map("feedback")
}

enum Department {
  POLICE @map("Police")
}